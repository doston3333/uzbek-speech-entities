STT_MODEL_ID=navai-uz/whisper-small-uzbek
NER_MODEL_PATH=./models/ner/final
# Set to 1 to skip GitHub/HF model downloads (offline / CI with fixtures only)
SKIP_MODEL_DOWNLOAD=
SPEECH_NER_RESCUE_ENABLED=true
SPEECH_NER_ANALYSIS_NORMALIZATION_ENABLED=true
MODEL_CACHE_DIR=./models/cache
MAX_AUDIO_SECONDS=60
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
